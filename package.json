{
  "name": "federation-composition-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root: the npm package (npm/), the upstream conformance check (conformance/) and the research site (research/). The Rust crates are in crates/.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "conformance": "node conformance/run.mjs",
    "conformance:watch": "node conformance/watch.mjs",
    "wasm:build": "pnpm --filter @lemonberrylabs/federation-composition-wasm run build",
    "test:npm": "pnpm --filter @lemonberrylabs/federation-composition-wasm run test",
    "bench:corpus": "node conformance/upstream-bin.mjs tsx --expose-gc bench/run-corpus.ts",
    "bench:native": "cargo run -p federation-composition-rs --release --example corpus_bench --",
    "bench:native:mimalloc": "cargo run -p federation-composition-rs --release --features mimalloc --example corpus_bench --",
    "bench:summarize": "node conformance/upstream-bin.mjs tsx bench/summarize.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.8.1"
  }
}
